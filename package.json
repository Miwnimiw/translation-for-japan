{
  "name": "kotoba-japanese-english-translator",
  "version": "1.0.0",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "concurrently \"next dev -p 3399\" \"wait-on http://localhost:3399 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "next build && npm run electron:compile && electron-builder",
    "electron:preview": "npm run electron:compile && electron ."
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "lucide-react": "^0.454.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  }
}
