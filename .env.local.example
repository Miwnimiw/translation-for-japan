# Copy this file to .env.local and fill in your real key.
# Get a free key from Google AI Studio: https://aistudio.google.com/app/apikey
#
# IMPORTANT: this key is read only on the server (in app/api/* routes and lib/gemini.ts).
# Never prefix it with NEXT_PUBLIC_, or it will be bundled into client-side JS and exposed
# in the browser.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
